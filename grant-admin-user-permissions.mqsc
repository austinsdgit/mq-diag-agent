* Grant admin_user permissions for DEADQ monitoring and queue management
SET AUTHREC PRINCIPAL('admin_user') OBJTYPE(QMGR) AUTHADD(CONNECT,INQ,DSP)
SET AUTHREC PROFILE('DEADQ') PRINCIPAL('admin_user') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('SYSTEM.DEAD.LETTER.QUEUE') PRINCIPAL('admin_user') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('**') PRINCIPAL('admin_user') OBJTYPE(QUEUE) AUTHADD(INQ,DSP,BROWSE,GET,PUT,SETALL,SETID)
* Allow connection on SYSTEM.DEF.SVRCONN channel
SET CHLAUTH(SYSTEM.DEF.SVRCONN) TYPE(USERMAP) CLNTUSER('admin_user') USERSRC(MAP) MCAUSER('admin_user') ACTION(REPLACE)
REFRESH SECURITY TYPE(CONNAUTH)
END