* Grant mqagent user permissions for DEADQ monitoring and live queue monitor
* CONNECT + INQ + DSP on qmgr — DSP is required for PCF MQCMD_INQUIRE_Q_NAMES / MQCMD_INQUIRE_Q
SET AUTHREC PRINCIPAL('mqagent') OBJTYPE(QMGR) AUTHADD(CONNECT,INQ,DSP)
SET AUTHREC PROFILE('DEV.DEAD.LETTER.QUEUE') PRINCIPAL('mqagent') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,DSP)
SET AUTHREC PROFILE('SYSTEM.DEAD.LETTER.QUEUE') PRINCIPAL('mqagent') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,DSP)
* Wildcard: INQ + DSP on all non-system queues (enables depth + maxdepth inquiry for live monitor)
SET AUTHREC PROFILE('**') PRINCIPAL('mqagent') OBJTYPE(QUEUE) AUTHADD(INQ,DSP)
* Allow connection on MQAGENT.SVRCONN channel
SET CHLAUTH(MQAGENT.SVRCONN) TYPE(USERMAP) CLNTUSER('mqagent') USERSRC(MAP) MCAUSER('mqagent') ACTION(REPLACE)
REFRESH SECURITY TYPE(CONNAUTH)
END